# Copia questo file in .env e inserisci i valori reali.

# Django
SECRET_KEY=django-cambia-questa-chiave-prima-della-produzione

# Email (password reset). Se EMAIL_HOST è vuoto, le email vanno in console (sviluppo).
# Porta 465 → EMAIL_USE_SSL=True e EMAIL_USE_TLS=False
# Porta 587 → EMAIL_USE_TLS=True e EMAIL_USE_SSL=False
EMAIL_HOST=posta.brembanarolle.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=plitta@brembanarolle.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Workflow <plitta@brembanarolle.com>
DEBUG=False
APP_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.136,workflow.azienda.local
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://192.168.0.136:8000,http://workflow.azienda.local:8000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USE_X_FORWARDED_PROTO=False

# Waitress (produzione Windows IIS — vedi README)
WAITRESS_HOST=127.0.0.1
WAITRESS_PORT=8000
WAITRESS_THREADS=8
WAITRESS_CHANNEL_TIMEOUT=120

# PostgreSQL esterno
DATABASE_URL=postgresql://brserver:password@host-postgresql:5432/workflow

# Share JOBS montata sul server Ubuntu host e passata al container.
FILESERVER_HOST_PATH=/mnt/jobs
FILESERVER_JOBS_PATH=/app/fileserver

# Database Access legacy (import commesse da Report)
ACCESS_MDB_PATH=Z:\Gestione Documenti\Gestione Documenti 2003.mdb
ACCESS_ODBC_DRIVER=Microsoft Access Driver (*.mdb, *.accdb)

# Business Central / SQL Server
BUSINESS_CENTRAL_SERVER=server\\istanza
BUSINESS_CENTRAL_DATABASE=BREMBANA_PROD
BUSINESS_CENTRAL_UID=utente
BUSINESS_CENTRAL_PSW=password
BUSINESS_CENTRAL_DRIVER=ODBC Driver 18 for SQL Server
BUSINESS_CENTRAL_TRUST_SERVER_CERTIFICATE=yes
